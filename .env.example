# Copy to .env and edit. docker compose reads .env automatically.

# --- Required ---
# Used by the gateway to verify tokens and by the user service to sign them.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- Postgres (keep the password URL-safe: letters, digits, _ and - only) ---
POSTGRES_USER=roast
POSTGRES_PASSWORD=roast_dev_password

# --- Dev-only admin account, created once when the database volume is first
# initialised. Change the password, or delete the account, before sharing
# this environment with anyone. ---
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=admin-dev-password

# --- Misc ---
LOG_LEVEL=info
ALLOWED_ORIGIN=http://localhost:5173
# Must be >= the "go" line in services/*/go.mod. Check: go version
GO_VERSION=1.24
